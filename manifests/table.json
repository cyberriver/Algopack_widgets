{
  "extensionId": "com.finamx.algopack.futoi.table",
  "displayName": "FUTOI таблица",
  "description": "Снимок открытых позиций физлиц и юрлиц. Обновление каждые 5 минут.",
  "visibility": "public",
  "platformSupport": [
    "web"
  ],
  "versions": [
    {
      "version": "1.0.1",
      "changelog": "Algopack_widgets: external pull, localhost bundle, default capabilities",
      "capabilitiesRequested": [
        "user.profile.read",
        "ui.toast"
      ],
      "surfaces": {
        "ui": {
          "renderMode": "external-embed",
          "embedBundleUrl": "https://cyberriver.github.io/Algopack_widgets/",
          "embedEntryPath": "/widgets/table/",
          "embedSandbox": "allow-scripts allow-popups"
        },
        "topics": {
          "publishes": [],
          "subscribes": [
            {
              "topicType": "com.finamx.algopack.futoi.filter"
            },
            {
              "topicType": "fdc3.instrument"
            },
            {
              "topicType": "finamx.timeframe"
            }
          ]
        }
      }
    }
  ]
}
