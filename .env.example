# ALGOPACK — only on this BFF. Never put in manifest, pubsub, or browser calls to apim.moex.com
ALGOPACK_TOKEN=

# Developer Portal token for finamx-ext / publish script. Never commit.
FINAMX_DEV_TOKEN=

# Public HTTPS origin of THIS app after you have a host.
# Local test uses http://localhost:3010 — the platform does not host the bundle.
EMBED_PUBLIC_URL=http://localhost:3010

# VPS (REG.RU Ubuntu + Docker)
# Without DOMAIN the app listens on APP_PORT (default 3010).
# With DOMAIN run: docker compose --profile https up -d
APP_PORT=3010
DOMAIN=
ACME_EMAIL=

# Extra CORS origins for /api/* (comma-separated). GitHub Pages and *.changesandbox.ru are already allowed.
CORS_ORIGINS=

# Only if the widget UI is hosted elsewhere (GitHub Pages) and must call this BFF.
# Baked into the image at build time — leave empty when UI and BFF are the same container.
# NEXT_PUBLIC_BFF_URL=https://futoi.example.ru
